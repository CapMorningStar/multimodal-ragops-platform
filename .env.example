# ==============================================================================
# GCP Environment Configuration
# ==============================================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Google Application Credentials (path to service account JSON key if running outside Cloud Run)
# GOOGLE_APPLICATION_CREDENTIALS=./service_account.json

# ==============================================================================
# Document AI Configuration
# ==============================================================================
# Processor ID for Document AI Layout Parser / Form Parser
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your-docai-processor-id

# ==============================================================================
# Vertex AI Model Endpoints
# ==============================================================================
VERTEX_MULTIMODAL_EMBEDDING_MODEL=multimodalembedding@001
GEMINI_LLM_MODEL=gemini-1.5-flash-002
GEMINI_CRAG_GRADER_MODEL=gemini-1.5-flash-002

# ==============================================================================
# Storage & Vector Search (Zero Idle Burn)
# ==============================================================================
# Set to 'local' for zero-cost ScaNN/NumPy cosine search during development
VECTOR_STORE_BACKEND=local
LOCAL_VECTOR_INDEX_DIR=./data/vector_index
PROCESSED_DATA_DIR=./data/processed
RAW_DATA_DIR=./data/raw

# Optional GCS bucket for staging raw PDFs in production
GCS_STAGING_BUCKET=your-gcp-project-id-rag-staging

# ==============================================================================
# LangGraph CRAG Hyperparameters
# ==============================================================================
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD_HIGH=0.75
RELEVANCE_THRESHOLD_LOW=0.40
MAX_REWRITE_RETRIES=2

# Optional Fallback Web Search API Key (Google Custom Search or Serper)
SERPER_API_KEY=

# ==============================================================================
# Budget Guardrails
# ==============================================================================
BUDGET_LIMIT_USD=300.00
BUDGET_ALERT_THRESHOLD_WARN=50.00
BUDGET_ALERT_THRESHOLD_CRITICAL=250.00

# ==============================================================================
# Service Configuration
# ==============================================================================
API_PORT=8000
UI_PORT=8501
LOG_LEVEL=INFO
